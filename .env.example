# Copy this file to .env for local development and replace placeholders locally.
# Never commit .env or put real values in this template.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_HSTS_SECONDS=31536000

TMDB_API_KEY=replace-with-your-tmdb-api-key

GMAIL_EMAIL=your-address@example.com
GMAIL_APP_PASSWORD=replace-with-a-gmail-app-password
DEFAULT_FROM_EMAIL=your-address@example.com

TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-your-twilio-number
TWILIO_DEFAULT_COUNTRY_CODE=91
